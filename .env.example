# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Canonical origin used for metadata, canonical URLs, sitemap, robots and OG images (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://myportfolio-gilt-xi-63.vercel.app

# Contact form (Resend — https://resend.com). Without RESEND_API_KEY the form shows a clear
# "email me directly" fallback instead of pretending to send.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=shivamsinghabc439@gmail.com
# Sender. Must be on a domain verified in Resend. "onboarding@resend.dev" only delivers to the
# email address that owns the Resend account.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
