    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.39.0",
    "matter-js": "^0.20.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.25.0",
